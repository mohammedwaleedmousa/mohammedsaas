{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "resolveJsonModule": true, "forceConsistentCasingInFileNames": true, "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  }
}
